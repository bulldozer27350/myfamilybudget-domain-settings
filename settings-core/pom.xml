<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        SILO-220 (doc/architecture/21-plan-silotage.md) : cœur du silo Paramètres. Il ne porte que la persistance
        JPA autonome (package `domain.settings.core.persistence` : entité `app_settings`, repository Spring Data et
        mapper), découverte par le scan par défaut de Spring Boot (racine `com.moe.myfamilybudget`).

        Règle : ce module ne dépend que de `settings-api` et de `infra-jpa`. Pas de `module-info` (décision D3).
        Seul le composition root (server) le référence ; `application` ne dépend que de `settings-api`.
    -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>domain-settings</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>settings-core</artifactId>
    <packaging>jar</packaging>
    <name>settings-core</name>
    <description>Cœur du silo Paramètres MyFamilyBudget (persistance JPA de la table app_settings)</description>

    <dependencies>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>settings-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>infra-jpa</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                REL-030 : japicmp compare l'API binaire de ce module a sa derniere version publiee
                (oldVersion=RELEASE). ignoreMissingOldVersion=true : ne fait pas echouer le build s'il n'y a
                encore aucune version publiee (silo tout juste cree). breakBuildOnBinaryIncompatibleModifications
                reste a true (herite de <pluginManagement> dans le pom racine) : un changement binaire non
                retrocompatible fait echouer `mvn verify`/`mvn clean verify`. Rapport : target/japicmp/japicmp.diff
                (et .xml) apres `mvn verify`.
            -->
            <plugin>
                <groupId>com.github.siom79.japicmp</groupId>
                <artifactId>japicmp-maven-plugin</artifactId>
                <configuration>
                    <oldVersion>
                        <dependency>
                            <groupId>com.moe.myfamilybudget</groupId>
                            <artifactId>settings-core</artifactId>
                            <version>RELEASE</version>
                        </dependency>
                    </oldVersion>
                    <parameter>
                        <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
                    </parameter>
                </configuration>
                <executions>
                    <execution>
                        <id>japicmp</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
